# Resend — used by app/api/contact/route.ts to email project inquiries
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@studionovelle.com

# Cal.com — used by /book (components/CalEmbed.tsx)
# Format: your-cal-username/event-slug
NEXT_PUBLIC_CAL_LINK=studio-novelle/discovery-call

# Paystack — used by /checkout/[slug] for fixed-price services
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave — alternative processor on the same checkout page
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Supabase — used to persist paid orders in app/api/paystack/verify/route.ts
# Service role key only — never expose this on the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — public/browser client, used only by /vault (client login
# + dashboard). Safe to expose; access is enforced by RLS policies in
# supabase/schema.sql, not by this key. Same project as above, just
# the public URL + anon key instead of the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the checkout link sent in quote emails, and as the
# magic-link redirect target for /vault. Set to your real domain in
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails allowed to use /admin/quotes and
# /admin/login. Checked server-side in lib/adminAuth.ts against the
# Supabase session — signing in with a magic link isn't enough on its
# own, the email must be in this list too.
ADMIN_EMAILS=you@studionovelle.com
